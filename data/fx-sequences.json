{
  "_doc_boatz": "BOATZ nautical presentation sequences live alongside the leftover critter demo ones (kept because the sequences editor + tests reference them). BOATZ sequences are fired client-side by SimScene from AUTHORITATIVE sim events (SimScene._fireEventFx) and observed snapshot deltas — never by the sim. Audio is a later pass, so they author `vfx` + `signal` steps ONLY (no `sfx`). Every referenced VFX is a one-shot with a duration (safe to fire from a sequence — a persistent effect would leak, having no removal id). `signal` steps route through onSignal → SimScene.onFxSignal, which writes ONLY to a scene-owned presentation overlay and NEVER mutates a snapshot. Positional sequences take opts.x/y (world) and opts.angle (= ship heading) so beam offsets rotate to the vessel's sides.",
  "sequences": {
    "critterSpawn": {
      "positional": true,
      "steps": [
        { "type": "signal", "name": "setState", "data": { "state": "idle" }, "delay": 0 },
        { "type": "vfx", "effect": "poof", "delay": 0 },
        { "type": "sfx", "sound": "spawnChirp", "delay": 0 },
        { "type": "sfx", "sound": "settleChirp", "delay": 220 }
      ]
    },
    "critterPet": {
      "positional": true,
      "steps": [
        { "type": "signal", "name": "setState", "data": { "state": "happy" }, "delay": 0 },
        { "type": "signal", "name": "restartClip", "delay": 0 },
        { "type": "vfx", "effect": "jolt", "delay": 0, "offsetRange": { "x": [-6, 6], "y": [-10, -4] } },
        { "type": "sfx", "sound": "happyChirp", "delay": 0, "repeat": [2, 3], "repeatDelay": 140 },
        { "type": "signal", "name": "clearState", "delay": 900 }
      ]
    },
    "critterScare": {
      "positional": true,
      "steps": [
        { "type": "signal", "name": "setState", "data": { "state": "scared" }, "delay": 0 },
        { "type": "signal", "name": "restartClip", "delay": 0 },
        { "type": "vfx", "effect": "jolt", "delay": 0 },
        { "type": "sfx", "sound": "squeak", "delay": 0 },
        { "type": "signal", "name": "clearState", "delay": 1200 }
      ]
    },
    "critterPair": {
      "positional": true,
      "steps": [
        { "type": "signal", "name": "setState", "data": { "state": "linked" }, "delay": 0 },
        { "type": "vfx", "effect": "poof", "delay": 0 },
        { "type": "sfx", "sound": "chord", "delay": 0 }
      ]
    },
    "critterDespawn": {
      "positional": true,
      "steps": [
        { "type": "signal", "name": "setState", "data": { "state": "scared" }, "delay": 0 },
        { "type": "vfx", "effect": "poof", "delay": 0 },
        { "type": "sfx", "sound": "thud", "delay": 0, "volume": 0.7 },
        { "type": "signal", "name": "removeEntity", "delay": 260 }
      ]
    },
    "gardenAmbience": {
      "steps": [
        { "type": "loopStart", "sound": "ambientMusic", "handle": "music", "delay": 0, "fadeIn": 1.5 },
        { "type": "loopStart", "sound": "windLoop", "handle": "wind", "delay": 0, "fadeIn": 2.0 }
      ]
    },
    "gardenAmbienceStop": {
      "steps": [
        { "type": "loopStop", "handle": "music", "delay": 0, "fadeOut": 1.0 },
        { "type": "loopStop", "handle": "wind", "delay": 0, "fadeOut": 1.0 }
      ]
    },

    "fireBroadside": {
      "positional": true,
      "steps": [
        { "type": "vfx", "effect": "muzzleFlash", "delay": 0, "offset": { "x": -5, "y": 9 } },
        { "type": "vfx", "effect": "cannonSmoke", "delay": 0, "offset": { "x": -5, "y": 11 } },
        { "type": "vfx", "effect": "muzzleFlash", "delay": 90, "offset": { "x": 6, "y": 9 } },
        { "type": "vfx", "effect": "cannonSmoke", "delay": 90, "offset": { "x": 6, "y": 11 } },
        { "type": "vfx", "effect": "muzzleFlash", "delay": 180, "offset": { "x": 0, "y": 9 } }
      ]
    },
    "shipHit": {
      "positional": true,
      "steps": [
        { "type": "vfx", "effect": "hullSplinters", "delay": 0 },
        { "type": "vfx", "effect": "cannonSplash", "delay": 60, "offsetRange": { "x": [-8, 8], "y": [-8, 8] } },
        { "type": "signal", "name": "markDamaged", "data": { "ttl": 1600 }, "delay": 0 }
      ]
    },
    "shipSinks": {
      "positional": true,
      "steps": [
        { "type": "vfx", "effect": "shipExplosion", "delay": 0 },
        { "type": "vfx", "effect": "cannonSplash", "delay": 260, "offsetRange": { "x": [-10, 10], "y": [-10, 10] } },
        { "type": "vfx", "effect": "cannonSmoke", "delay": 400 }
      ]
    },
    "raidPlunder": {
      "positional": true,
      "steps": [
        { "type": "vfx", "effect": "muzzleFlash", "delay": 0, "offset": { "x": 0, "y": 8 } },
        { "type": "vfx", "effect": "cannonSmoke", "delay": 0, "offset": { "x": 0, "y": 10 } },
        { "type": "vfx", "effect": "goldBurst", "delay": 200 },
        { "type": "signal", "name": "markDamaged", "data": { "ttl": 1400 }, "delay": 0 }
      ]
    },
    "tradeComplete": {
      "positional": true,
      "steps": [
        { "type": "vfx", "effect": "goldBurst", "delay": 0 }
      ]
    },
    "depart": {
      "positional": true,
      "steps": [
        { "type": "vfx", "effect": "cannonSplash", "delay": 0 }
      ]
    },
    "arrive": {
      "positional": true,
      "steps": [
        { "type": "vfx", "effect": "cannonSplash", "delay": 0 }
      ]
    }
  }
}
